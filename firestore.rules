rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Pemeriksaan role Petugas/Admin berdasarkan profil tepercaya di Firestore
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']) ||
        (request.auth.token.email != null &&
         request.auth.token.email.matches('.*@umm[.]ac[.]id$') &&
         !request.auth.token.email.matches('.*@webmail[.]umm[.]ac[.]id$'))
      );
    }

    // Pemeriksaan role Mahasiswa berdasarkan profil tepercaya di Firestore
    function isStudent() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student') ||
        (request.auth.token.email != null &&
         request.auth.token.email.matches('.*@webmail[.]umm[.]ac[.]id$'))
      );
    }

    // 1. Koleksi items (Barang Hilang & Temuan)
    match /items/{itemId} {
      // Seluruh pengguna kampus dapat membaca katalog barang
      allow read: if true;

      // Create:
      // Mahasiswa HANYA boleh membuat laporan barang hilang (type == 'lost')
      // Petugas/Admin dapat membuat laporan barang hilang maupun barang temuan (type == 'found')
      allow create: if isAuthenticated() && (
        (request.resource.data.type == 'lost' && (request.resource.data.userId == request.auth.uid || isStudent())) ||
        isAdmin()
      );

      // Update:
      // Mahasiswa TIDAK BOLEH mengedit atau mengubah status barang temuan (type == 'found')
      // Mahasiswa hanya boleh memperbarui laporan barang hilang miliknya sendiri
      // Petugas/Admin berwenang memperbarui seluruh barang temuan maupun barang hilang
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.type == 'lost' &&
        request.resource.data.type == 'lost' &&
        resource.data.userId == request.auth.uid
      );

      // Delete:
      // Mahasiswa TIDAK BOLEH menghapus barang temuan
      // Petugas/Admin berwenang menghapus data barang temuan dan barang hilang
      // Mahasiswa hanya dapat membatalkan/menghapus laporan barang hilang miliknya sendiri
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.type == 'lost' &&
        resource.data.userId == request.auth.uid
      );
    }

    // 2. Koleksi claims (Pengajuan Klaim Barang)
    match /claims/{claimId} {
      // Mahasiswa pemilik klaim atau Petugas dapat membaca data klaim
      allow read: if isAuthenticated();

      // Mahasiswa terdaftar dapat mengajukan klaim
      allow create: if isAuthenticated();

      // Hanya Petugas/Admin yang dapat memverifikasi atau memperbarui klaim
      allow update: if isAdmin();

      // Hanya Admin/Petugas yang dapat menghapus klaim
      allow delete: if isAdmin();
    }

    // 3. Koleksi users (Profil Mahasiswa)
    match /users/{userId} {
      // Mahasiswa dapat membaca profilnya sendiri, Petugas/Admin dapat membaca seluruh profil
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Pengguna hanya dapat mengedit profil mereka sendiri, Admin dapat mengelola
      allow write: if isOwner(userId) || isAdmin();
    }

    // 4. Koleksi admins (Profil Petugas/Admin)
    match /admins/{adminId} {
      // Akun terotentikasi dapat membaca informasi petugas
      allow read: if isAuthenticated();

      // Hanya Admin/Petugas yang dapat mengelola profil pengelola
      allow write: if isAdmin();
    }
  }
}
